<UserControl
    x:Class="DIHub.APP.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DIHub.Core.Models"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <!-- Backdrop -->
    <Grid Background="#B3000000" Tapped="OnBackdropTapped">
        <!-- Panel hit-test guard (prevents backdrop close when clicking inside) -->
        <Grid Background="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,120,0,0"
              Tapped="OnPanelTapped">

            <Border Width="640"
                    MaxHeight="520"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search box -->
                    <Grid Grid.Row="0" Padding="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE721;"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Foreground="{StaticResource AppTextSecondaryBrush}" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="15"
                                 VerticalAlignment="Center"
                                 PlaceholderText="Type a command or search..."
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown" />

                        <Border Grid.Column="2"
                                Padding="6,2"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{StaticResource AppSecondaryBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="ESC"
                                       FontSize="10"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1"
                               Fill="{StaticResource AppBorderBrush}" />

                    <!-- Results -->
                    <ListView x:Name="ResultsList"
                              Grid.Row="2"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnItemClicked"
                              Padding="6,4,6,8"
                              MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommandItem">
                                <Grid Padding="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind Icon}"
                                              FontSize="16"
                                              Width="28"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource AppTextPrimaryBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Padding="6,2"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AppSecondaryBrush}">
                                        <TextBlock Text="{x:Bind CategoryLabel}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyText"
                               Grid.Row="2"
                               Text="No matching commands"
                               FontSize="12"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,40"
                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>