<UserControl
    x:Class="DIHub.APP.Controls.Extensions.ExtensionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Width="240"
            Height="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ Top: Icon + Name + Version ══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon (image with glyph fallback) -->
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="{ThemeResource AppSecondaryBrush}">
                    <Grid>
                        <Image x:Name="IconImage"
                               Width="32" Height="32"
                               Stretch="Uniform"
                               Visibility="Collapsed" />
                        <FontIcon x:Name="IconGlyph"
                                  FontSize="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource AppAccentBrush}"
                                  Glyph="&#xE7B8;" />
                    </Grid>
                </Border>

                <!-- Name + version -->
                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock x:Name="NameText"
                               Text="Extension"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock x:Name="VersionText"
                               Text="v0.0.0"
                               FontSize="10"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- ══ Middle: Description + Category badge ══ -->
            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0"
                        Spacing="6">
                <TextBlock x:Name="DescriptionText"
                           Text="Description"
                           FontSize="11"
                           MaxLines="3"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource AppTextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border x:Name="CategoryBadge"
                            Background="{ThemeResource AppSecondaryBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                        <TextBlock x:Name="CategoryText"
                                   Text="Category"
                                   FontSize="9"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ══ Bottom: Actions ══ -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Details button -->
                <Button x:Name="DetailsButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10,6"
                        Background="{ThemeResource AppSecondaryBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnDetailsClicked">
                    <TextBlock Text="Details"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Button>

                <!-- Install button OR Installed indicator (mutually exclusive) -->
                <Grid Grid.Column="1" Margin="6,0,0,0">

                    <!-- Install button: shown when NOT installed -->
                    <Button x:Name="InstallButton"
                            Width="34" Height="30"
                            Padding="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnInstallClicked"
                            ToolTipService.ToolTip="Install this extension">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                    </Button>

                    <!-- Installed indicator: shown when installed -->
                    <Border x:Name="InstalledIndicator"
                            Background="{ThemeResource AppSecondaryBrush}"
                            BorderBrush="{StaticResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="10"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource AppAccentBrush}" />
                            <TextBlock Text="Installed"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AppAccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>