<UserControl
    x:Class="DIHub.APP.Controls.Extensions.ExtensionDiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
        <StackPanel Spacing="14">

            <!-- Title + refresh -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Extension Diagnostics"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Environment and installation status"
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Padding="10,6"
                        Background="{ThemeResource AppSecondaryBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnRefreshClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                        <TextBlock Text="Refresh" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Environment card -->
            <Border Background="{ThemeResource AppSecondaryBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel x:Name="EnvironmentPanel" Spacing="8" />
            </Border>

            <!-- Extensions card -->
            <Border Background="{ThemeResource AppSecondaryBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Installed extensions"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />

                    <StackPanel x:Name="ExtensionsList" Spacing="6" />

                    <TextBlock x:Name="NoExtensionsText"
                               Text="No extensions installed."
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Profile assignment card -->
            <Border Background="{ThemeResource AppSecondaryBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Assignments"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />

                    <StackPanel x:Name="AssignmentsList" Spacing="6" />

                    <TextBlock x:Name="NoAssignmentsText"
                               Text="No assignments yet."
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>