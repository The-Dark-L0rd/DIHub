<UserControl
    x:Class="DIHub.APP.Controls.MultiAIPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="RootBorder"
            Background="{ThemeResource AppSecondaryBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header (compact) -->
            <Grid Grid.Row="0"
                  Padding="4,0,4,0"
                  Background="{ThemeResource AppSurfaceBrush}"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="0,0,0,1"
                  DoubleTapped="OnHeaderDoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="TargetCheck"
                          Grid.Column="0"
                          MinWidth="0"
                          MinHeight="0"
                          Padding="2,0"
                          VerticalAlignment="Center"
                          Checked="OnTargetCheckChanged"
                          Unchecked="OnTargetCheckChanged"
                          ToolTipService.ToolTip="Send prompts to this panel" />

                <FontIcon x:Name="HeaderIcon"
                          Grid.Column="1"
                          Glyph="&#xE774;"
                          FontSize="10"
                          VerticalAlignment="Center"
                          Margin="2,0,6,0"
                          Foreground="{StaticResource AppAccentBrush}" />

                <TextBlock x:Name="HeaderTitle"
                           Grid.Column="2"
                           Text="Empty Panel"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <Border x:Name="StatusChip"
                        Grid.Column="3"
                        Margin="0,0,3,0"
                        Padding="5,1"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               FontSize="9"
                               Foreground="White" />
                </Border>

                <Button x:Name="MaximizeButton"
                        Grid.Column="4"
                        Width="18" Height="18"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnMaximizeClicked"
                        ToolTipService.ToolTip="Maximize (double-click header)">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE740;" FontSize="9" />
                </Button>

                <Button Grid.Column="5"
                        Width="18" Height="18"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Panel options">
                    <FontIcon Glyph="&#xE712;" FontSize="9" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Choose AI..." Click="OnChooseClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Change AI..." Click="OnChooseClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Move Left" Click="OnMoveLeftClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE76B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Move Right" Click="OnMoveRightClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE76C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Maximize Panel" Click="OnMaximizeClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE740;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Reload" Click="OnReloadClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Hard Reload" Click="OnHardReloadClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open in Browser" Click="OnOpenExternalClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Clear Session" Click="OnClearSessionClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Remove Panel" Click="OnRemoveClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid x:Name="BodyGrid" Grid.Row="1">
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <FontIcon Glyph="&#xE710;"
                              FontSize="28"
                              Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <TextBlock Text="No AI selected"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <Button Content="Choose AI"
                            Click="OnChooseClicked"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="11"
                            Padding="12,6" />
                </StackPanel>

                <Grid x:Name="WebHostContainer" Visibility="Collapsed" />

                <Border x:Name="DispatchOverlay"
                        Background="#CC000000"
                        Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <ProgressRing IsActive="True" Width="26" Height="26" />
                        <TextBlock x:Name="DispatchOverlayText"
                                   Text="Sending..."
                                   Foreground="White"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>