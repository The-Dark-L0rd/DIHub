<UserControl
    x:Class="DIHub.APP.Views.MultiAIView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Top Bar ══ -->
        <Border Grid.Row="0"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Icon + Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71D;" FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock Text="Multi-AI Workspace"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Combo + Close -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <ComboBox x:Name="LayoutCombo"
                              MinWidth="88"
                              Height="20"
                              FontSize="10"
                              Padding="6,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OnLayoutChanged">
                        <ComboBoxItem Content="2 Panels" Tag="2" FontSize="10" />
                        <ComboBoxItem Content="3 Panels" Tag="3" FontSize="10" />
                        <ComboBoxItem Content="4 Panels" Tag="4" FontSize="10" />
                    </ComboBox>

                    <Button Width="20" Height="20"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseClicked"
                            ToolTipService.ToolTip="Close Multi-AI (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Panel Grid ══ -->
        <Grid x:Name="PanelGrid"
              Grid.Row="1"
              Padding="6"
              ColumnSpacing="6"
              RowSpacing="6" />

        <!-- ══ Prompt Composer ══ -->
        <Border Grid.Row="2"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <StackPanel Spacing="6">

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Targets:"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />

                    <StackPanel x:Name="TargetChipsPanel"
                                Orientation="Horizontal"
                                Spacing="4" />

                    <Button x:Name="TargetsAllButton"
                            Content="All"
                            FontSize="10"
                            Height="22"
                            Padding="8,0"
                            Click="OnTargetsAllClicked"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AppBorderBrush}" />

                    <Button x:Name="TargetsNoneButton"
                            Content="None"
                            FontSize="10"
                            Height="22"
                            Padding="8,0"
                            Click="OnTargetsNoneClicked"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AppBorderBrush}" />

                    <Button x:Name="PresetsButton"
                            FontSize="10"
                            Height="22"
                            Padding="8,0"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            ToolTipService.ToolTip="Target presets">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE734;" FontSize="10" />
                            <TextBlock Text="Presets" FontSize="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="PresetsMenu" Placement="Top" />
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="HistoryButton"
                            FontSize="10"
                            Height="22"
                            Padding="8,0"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AppBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE81C;" FontSize="10" />
                            <TextBlock Text="History" FontSize="10" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="HistoryFlyout" Placement="Top">
                                <StackPanel Spacing="8" Width="380">
                                    <TextBlock Text="Recent Prompts"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="13" />
                                    <ScrollViewer MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="HistoryList" Spacing="4" />
                                    </ScrollViewer>
                                    <Button x:Name="ClearHistoryButton"
                                            Content="Clear History"
                                            FontSize="10"
                                            HorizontalAlignment="Right"
                                            Click="OnClearHistoryClicked" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="RetryFailedButton"
                            FontSize="10"
                            Height="22"
                            Padding="8,0"
                            Click="OnRetryFailedClicked"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AppBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="10" />
                            <TextBlock x:Name="RetryFailedText" Text="Retry Failed" FontSize="10" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PromptInput"
                             Grid.Column="0"
                             PlaceholderText="Ask multiple AIs..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="40"
                             MaxHeight="80"
                             FontSize="12"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="8,6"
                             KeyDown="OnPromptKeyDown" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Spacing="4">

                        <CheckBox x:Name="KeepTargetsCheck"
                                  Content="Keep targets"
                                  FontSize="10"
                                  MinHeight="0"
                                  Checked="OnKeepTargetsChanged"
                                  Unchecked="OnKeepTargetsChanged" />

                        <Button x:Name="SendButton"
                                Click="OnSendClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,6"
                                MinWidth="100">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SendButtonText"
                                           Text="Send"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                                <FontIcon Glyph="&#xE724;" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                FontSize="10"
                                Height="22"
                                HorizontalAlignment="Stretch"
                                Click="OnCancelClicked"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ComposerStatus"
                           FontSize="10"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           Text="Type a prompt and select which panels should receive it." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>