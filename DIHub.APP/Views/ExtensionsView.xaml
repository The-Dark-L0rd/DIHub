<UserControl
    x:Class="DIHub.APP.Views.ExtensionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DIHub.APP.Controls.Extensions"
    xmlns:vm="using:DIHub.APP.ViewModels"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <!-- Backdrop + auto-sized modal -->
    <Grid x:Name="BackdropGrid"
          Background="#80000000"
          SizeChanged="OnBackdropSizeChanged"
          Tapped="OnBackdropTapped">

        <!-- Modal panel: size is driven from code-behind so it never
             exceeds the window bounds (prevents overlap with the
             window caption buttons). -->
        <Grid x:Name="ModalPanel"
              Background="{ThemeResource AppBackgroundBrush}"
              Width="1100" Height="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="12"
              BorderBrush="{ThemeResource AppBorderBrush}"
              BorderThickness="1"
              Tapped="OnPanelTapped">

            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,0"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16"
                              Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock Text="Extensions"
                               Style="{StaticResource HeadingTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">

                    <Button x:Name="InstallMenuButton"
                            Padding="12,6"
                            Background="{StaticResource AppAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="White" />
                            <TextBlock Text="Install" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="White" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="From URL..."
                                                Click="OnInstallFromUrlClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="From folder..."
                                                Click="OnInstallFromFolderClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="From ZIP archive..."
                                                Click="OnInstallFromZipClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseClicked"
                            ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab strip -->
            <Grid Grid.Row="1"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TabDiscoverButton"
                            Content="Discover"
                            Tag="discover"
                            FontSize="12"
                            Padding="14,6"
                            Click="OnTabClicked" />
                    <Button x:Name="TabInstalledButton"
                            Content="Installed"
                            Tag="installed"
                            FontSize="12"
                            Padding="14,6"
                            Click="OnTabClicked" />
                    <Button x:Name="TabUpdatesButton"
                            Content="Updates"
                            Tag="updates"
                            FontSize="12"
                            Padding="14,6"
                            Click="OnTabClicked" />
                    <Button x:Name="TabDiagnosticsButton"
                            Content="Diagnostics"
                            Tag="diagnostics"
                            FontSize="12"
                            Padding="14,6"
                            Click="OnTabClicked" />
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="2">

                <!-- DISCOVER -->
                <ScrollViewer x:Name="ContentDiscover"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,16,20,20">
                    <StackPanel Spacing="16">
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="Search extensions by name, author, category, or tag..."
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 FontSize="12" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CategoryChipsPanel"
                                        Orientation="Horizontal"
                                        Spacing="6" />
                        </ScrollViewer>

                        <StackPanel x:Name="FeaturedSection" Spacing="10">
                            <TextBlock Text="Featured"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FeaturedCards, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                       MaximumRowsOrColumns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogCardViewModel">
                                        <controls:ExtensionCard Item="{x:Bind Item}"
                                                                IsInstalled="{x:Bind IsInstalled, Mode=OneWay}"
                                                                Margin="4"
                                                                ActionRequested="OnCardActionRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock x:Name="AllHeaderText"
                                       Text="All extensions"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AllCards, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                       MaximumRowsOrColumns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogCardViewModel">
                                        <controls:ExtensionCard Item="{x:Bind Item}"
                                                                IsInstalled="{x:Bind IsInstalled, Mode=OneWay}"
                                                                Margin="4"
                                                                ActionRequested="OnCardActionRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="DiscoverEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="40"
                                    Spacing="10"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE721;"
                                      FontSize="36"
                                      Foreground="{ThemeResource AppTextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No extensions match your search"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Try a different keyword or clear the filters."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- INSTALLED -->
                <ScrollViewer x:Name="ContentInstalled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,16,20,20"
                              Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.InstalledCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstalledItemViewModel">
                                    <controls:InstalledExtensionItem
                                        Item="{x:Bind Info}"
                                        EffectiveState="{x:Bind State}"
                                        Margin="0,0,0,8"
                                        ActionRequested="OnItemActionRequested" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="InstalledEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="40"
                                    Spacing="10"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8B7;"
                                      FontSize="36"
                                      Foreground="{ThemeResource AppTextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No extensions installed yet"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Use the Discover tab to find and install extensions."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- UPDATES -->
                <Grid x:Name="ContentUpdates"
                      Visibility="Collapsed"
                      Padding="20,16">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <FontIcon Glyph="&#xE72C;"
                                  FontSize="36"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No updates available"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Automatic updates are not enabled yet. Check back later."
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- DIAGNOSTICS -->
                <controls:ExtensionDiagnosticsPanel x:Name="ContentDiagnostics"
                                                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Progress overlay -->
        <Grid x:Name="ProgressOverlay"
              Background="#A0000000"
              Visibility="Collapsed"
              Tapped="OnProgressBackdropTapped">
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ProgressTitle"
                               Text="Installing extension..."
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock x:Name="ProgressSubtitle"
                               Text=""
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <ProgressBar x:Name="ProgressBar"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock x:Name="ProgressDetail"
                               Text=""
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <Button x:Name="ProgressCancelButton"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0"
                            Click="OnProgressCancelClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>