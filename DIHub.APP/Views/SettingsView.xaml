<UserControl
    x:Class="DIHub.APP.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Grid Background="#80000000" Tapped="OnBackdropTapped">
        <Grid Background="{ThemeResource AppBackgroundBrush}"
              Width="960" Height="640"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="12"
              BorderBrush="{ThemeResource AppBorderBrush}"
              BorderThickness="1"
              Tapped="OnPanelTapped">

            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,0"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="16"
                              Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock Text="Settings"
                               Style="{StaticResource HeadingTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="32" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClicked">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Padding="8" Spacing="2">
                        <ListView x:Name="NavList"
                                  SelectionMode="Single"
                                  SelectionChanged="OnNavSelectionChanged"
                                  Background="Transparent"
                                  Padding="0">
                            <ListViewItem Tag="general">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="General" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="appearance">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                    <TextBlock Text="Appearance" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="browser">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Browser" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="multi-ai">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                    <TextBlock Text="Multi-AI" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="extensions">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Extensions" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="shortcuts">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE765;" FontSize="14" />
                                    <TextBlock Text="Shortcuts" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="privacy">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                    <TextBlock Text="Privacy" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="about">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock Text="About" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="28,24">
                    <StackPanel Spacing="20">

                        <!-- GENERAL -->
                        <StackPanel x:Name="SectionGeneral" Spacing="16">
                            <TextBlock Text="General" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Startup and window behavior"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <ToggleSwitch x:Name="RestoreSessionToggle"
                                          Header="Restore previous session"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnRestoreSessionToggled" />

                            <ToggleSwitch x:Name="StartWithWindowsToggle"
                                          Header="Start with Windows"
                                          OnContent="On" OffContent="Off"
                                          IsEnabled="False"
                                          Toggled="OnStartWithWindowsToggled" />

                            <ToggleSwitch x:Name="ConfirmCloseToggle"
                                          Header="Confirm before closing multiple tabs"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnConfirmCloseToggled" />

                            <ToggleSwitch x:Name="RunBackgroundToggle"
                                          Header="Run in background"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnRunBackgroundToggled" />
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel x:Name="SectionAppearance"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Appearance" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Customize the look and feel"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Theme" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton x:Name="ThemeDark" GroupName="Theme"
                                                 Content="Dark" Checked="OnThemeChanged" />
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme"
                                                 Content="Light" Checked="OnThemeChanged" />
                                    <RadioButton x:Name="ThemeSystem" GroupName="Theme"
                                                 Content="System" Checked="OnThemeChanged" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Accent Color" FontWeight="SemiBold" />
                                <StackPanel x:Name="AccentPanel"
                                            Orientation="Horizontal"
                                            Spacing="8" />
                            </StackPanel>

                            <ToggleSwitch x:Name="SidebarDefaultToggle"
                                          Header="Sidebar expanded by default"
                                          OnContent="Expanded"
                                          OffContent="Collapsed"
                                          Toggled="OnSidebarDefaultToggled" />

                            <ToggleSwitch x:Name="AnimationsToggle"
                                          Header="Enable animations"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnAnimationsToggled" />
                        </StackPanel>

                        <!-- BROWSER -->
                        <StackPanel x:Name="SectionBrowser"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Browser" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Link and search behavior"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Open links in" FontWeight="SemiBold" />
                                <ComboBox x:Name="OpenLinksCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnOpenLinksChanged">
                                    <ComboBoxItem Content="Current Tab" Tag="CurrentTab" />
                                    <ComboBoxItem Content="New Tab" Tag="NewTab" />
                                    <ComboBoxItem Content="External Browser" Tag="ExternalBrowser" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="External browser" FontWeight="SemiBold" />
                                <ComboBox x:Name="ExternalBrowserCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnExternalBrowserChanged">
                                    <ComboBoxItem Content="System Default" Tag="Default" />
                                    <ComboBoxItem Content="Google Chrome" Tag="Chrome" />
                                    <ComboBoxItem Content="Microsoft Edge" Tag="Edge" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Search engine" FontWeight="SemiBold" />
                                <ComboBox x:Name="SearchEngineCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnSearchEngineChanged">
                                    <ComboBoxItem Content="Google" Tag="Google" />
                                    <ComboBoxItem Content="Bing" Tag="Bing" />
                                    <ComboBoxItem Content="DuckDuckGo" Tag="DuckDuckGo" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- MULTI-AI -->
                        <StackPanel x:Name="SectionMultiAI"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Multi-AI" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Configure the Multi-AI workspace"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Default panel count" FontWeight="SemiBold" />
                                <ComboBox x:Name="MultiAIPanelCountCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnMultiAIPanelCountChanged">
                                    <ComboBoxItem Content="2 Panels" Tag="2" />
                                    <ComboBoxItem Content="3 Panels" Tag="3" />
                                    <ComboBoxItem Content="4 Panels" Tag="4" />
                                </ComboBox>
                            </StackPanel>

                            <ToggleSwitch x:Name="MultiAIConfirmSendToggle"
                                          Header="Confirm multi-send"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIConfirmSendToggled" />

                            <ToggleSwitch x:Name="MultiAIKeepTargetsToggle"
                                          Header="Keep targets for next message (default)"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIKeepTargetsToggled" />

                            <ToggleSwitch x:Name="MultiAIRememberTargetsToggle"
                                          Header="Remember last target selection"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIRememberTargetsToggled" />

                            <ToggleSwitch x:Name="MultiAIAutoFocusToggle"
                                          Header="Auto-focus active panel"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIAutoFocusToggled" />

                            <ToggleSwitch x:Name="MultiAIAutomaticDispatchToggle"
                                          Header="Automatic prompt dispatch"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIAutomaticDispatchToggled" />

                            <ToggleSwitch x:Name="MultiAIProviderAutomationToggle"
                                          Header="Allow provider-specific automation"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnMultiAIProviderAutomationToggled" />
                        </StackPanel>

                        <!-- EXTENSIONS -->
                        <StackPanel x:Name="SectionExtensions"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Extensions" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Browser extension platform"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <Border Background="{ThemeResource AppSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⚠ Changes to the master switch take effect after restarting DI Hub."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <ToggleSwitch x:Name="ExtensionsEnabledToggle"
                                          Header="Enable browser extensions (restart required)"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnExtensionsEnabledToggled" />

                            <ToggleSwitch x:Name="AllowLocalExtensionsToggle"
                                          Header="Allow local extensions (folder / ZIP)"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnAllowLocalExtensionsToggled" />

                            <ToggleSwitch x:Name="AllowRemoteExtensionsToggle"
                                          Header="Allow remote extensions (download URL)"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnAllowRemoteExtensionsToggled" />

                            <ToggleSwitch x:Name="ExtensionConfirmInstallToggle"
                                          Header="Confirm before installing"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnExtensionConfirmInstallToggled" />

                            <ToggleSwitch x:Name="ExtensionShowPermissionWarningsToggle"
                                          Header="Show permission warnings"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnExtensionShowPermissionWarningsToggled" />

                            <ToggleSwitch x:Name="ExtensionSafeModeToggle"
                                          Header="Safe mode — do not apply extensions to any profile"
                                          OnContent="On" OffContent="Off"
                                          Toggled="OnExtensionSafeModeToggled" />

                            <Button Content="Open Extensions Manager"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Click="OnOpenExtensionsClicked" />

                            <Button Content="Open Extension Diagnostics"
                                    HorizontalAlignment="Left"
                                    Click="OnOpenExtensionDiagnosticsClicked" />
                        </StackPanel>

                        <!-- SHORTCUTS -->
                        <StackPanel x:Name="SectionShortcuts"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Quick reference for all available keyboard commands"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <Border Background="{ThemeResource AppSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <StackPanel>
                                    <Grid Padding="16,10"
                                          BorderBrush="{ThemeResource AppBorderBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Shortcut"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Action"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Grid>
                                    <StackPanel x:Name="ShortcutsList" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tip: All shortcuts work globally unless focus is inside a WebView2 panel."
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontStyle="Italic"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- PRIVACY -->
                        <StackPanel x:Name="SectionPrivacy"
                                    Spacing="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Privacy" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Manage your browsing data"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,-8,0,8" />

                            <Border Padding="16"
                                    Background="{ThemeResource AppSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Clearing the data below will sign you out from all AI services."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               FontSize="12" />
                                    <Button Content="Clear All Browsing Data"
                                            HorizontalAlignment="Left"
                                            Click="OnClearAllDataClicked" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="No telemetry or tracking is enabled."
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- ABOUT -->
                        <StackPanel x:Name="SectionAbout"
                                    Spacing="20"
                                    Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource TitleTextStyle}" />

                            <Border Background="{ThemeResource AppSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Border Width="52" Height="52"
                                                CornerRadius="12"
                                                Background="{StaticResource AppAccentBrush}">
                                            <FontIcon Glyph="&#xE99A;"
                                                      FontSize="24"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="DI Hub"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Unified AI Workspace for Windows"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource AppBorderBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Version"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="3.12.0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Built with"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="C# / .NET 10 / WinUI 3 / WebView2"
                                                   FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource AppSecondaryBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="CREATOR"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="{ThemeResource AppSurfaceBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xE77B;"
                                                      FontSize="18"
                                                      Foreground="{StaticResource AppAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DARK L0RD"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Developer and Designer"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource AppBorderBrush}" />

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,10"
                                            Background="{ThemeResource AppSurfaceBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Tag="https://github.com/The-Dark-L0rd"
                                            Click="OnOpenLinkClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE774;"
                                                      FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Foreground="{StaticResource AppAccentBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="GitHub"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="The-Dark-L0rd"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2"
                                                      Glyph="&#xE8A7;"
                                                      FontSize="11"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,10"
                                            Background="{ThemeResource AppSurfaceBrush}"
                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Tag="https://t.me/DARK_L0RD"
                                            Click="OnOpenLinkClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE8F2;"
                                                      FontSize="14"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Foreground="{StaticResource AppAccentBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="Telegram"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="@DARK_L0RD"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2"
                                                      Glyph="&#xE8A7;"
                                                      FontSize="11"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="© 2026 DARK L0RD. All rights reserved."
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>