<UserControl
    x:Class="DIHub.APP.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DIHub.APP.Controls"
    xmlns:views="using:DIHub.APP.Views"
    xmlns:models="using:DIHub.Core.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnCommandPaletteInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnFocusAddressBarInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OnNewTabInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnCloseTabInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" Invoked="OnRestoreTabInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnReloadInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="OnNextTabInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="OnPrevTabInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnDevToolsInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="M" Invoked="OnMultiAIInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="8,0,12,0"
              Background="{ThemeResource AppSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="SidebarToggleButton" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnSidebarToggleClicked"
                        ToolTipService.ToolTip="Toggle sidebar (Ctrl+Shift+B)">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="B" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button x:Name="MultiAIButton" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnMultiAIButtonClicked"
                        ToolTipService.ToolTip="Multi-AI Workspace (Ctrl+Shift+M)">
                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                </Button>

                <Button x:Name="SettingsButton" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnSettingsButtonClicked"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>

                <FontIcon Glyph="&#xE99A;" FontSize="16" Foreground="{StaticResource AppAccentBrush}" />
                <TextBlock Text="DI Hub" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search Box (clickable, opens Command Palette) -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnSearchBoxClicked"
                    ToolTipService.ToolTip="Open Command Palette (Ctrl+K)">
                <Border Background="{ThemeResource AppSecondaryBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusMd}"
                        Padding="12,6"
                        Width="320">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="12"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <TextBlock Text="Search or press Ctrl+K..."
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" x:Name="SidebarPanel" Width="240"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="0,1,1,0"
                    SizeChanged="OnSidebarSizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,12,12,4" Spacing="4">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource CaptionTextStyle}"
                                   FontWeight="SemiBold" Margin="4,0,0,4" />

                        <Button x:Name="WorkspaceButton"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,8"
                                Background="{ThemeResource AppSecondaryBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="{x:Bind ViewModel.ActiveWorkspace.Icon, Mode=OneWay}"
                                          FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                          Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveWorkspace.Name, Mode=OneWay}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Grid>
                            <Button.Flyout>
                                <MenuFlyout x:Name="WorkspaceMenu" Placement="Bottom" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="AI SERVICES"
                               Style="{StaticResource CaptionTextStyle}"
                               FontWeight="SemiBold" Margin="16,8,16,8" />

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                            <ItemsControl x:Name="ServicesList"
                                          ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AIService">
                                        <Expander HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="0,1">
                                            <Expander.Header>
                                                <Grid Padding="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}"
                                                              FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                                              Foreground="{x:Bind Accent, Converter={StaticResource AccentColorToBrushConverter}}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="13" />

                                                    <Button Grid.Column="2"
                                                            Width="28" Height="28"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Tag="{Binding}"
                                                            ToolTipService.ToolTip="Service options">
                                                        <FontIcon Glyph="&#xE712;" FontSize="11" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuFlyoutItem Text="Open Default Account"
                                                                                Tag="{Binding}"
                                                                                Click="OnServiceOpenDefaultClicked">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE8A7;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Add Account..."
                                                                                Tag="{Binding}"
                                                                                Click="OnAddAccountClicked">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE710;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="Open in Browser"
                                                                                Tag="{Binding}"
                                                                                Click="OnServiceOpenExternalClicked">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE774;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="Delete Service"
                                                                                Tag="{Binding}"
                                                                                Click="OnDeleteServiceClicked">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE74D;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel Spacing="2" Margin="0,2,0,4">
                                                <ItemsControl ItemsSource="{x:Bind Accounts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AIAccount">
                                                            <Button HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Padding="8,6"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="6"
                                                                    Tag="{Binding}"
                                                                    Click="OnAccountClicked"
                                                                    ToolTipService.ToolTip="{x:Bind Name}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Grid.Column="0"
                                                                              Glyph="{x:Bind Icon, Mode=OneWay}"
                                                                              FontSize="12" VerticalAlignment="Center"
                                                                              Margin="0,0,8,0"
                                                                              Foreground="{x:Bind Accent, Mode=OneWay, Converter={StaticResource AccentColorToBrushConverter}}" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}"
                                                                               FontSize="12" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="10"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{StaticResource AppAccentBrush}"
                                                                              Visibility="{x:Bind Favorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </Grid>
                                                                <Button.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem Text="Open" Tag="{Binding}" Click="OnAccountOpenClicked" />
                                                                        <MenuFlyoutItem Text="Open in New Tab" Tag="{Binding}" Click="OnAccountOpenNewTabClicked" />
                                                                        <MenuFlyoutSeparator />
                                                                        <MenuFlyoutItem Text="Set as Default" Tag="{Binding}" Click="OnAccountSetDefaultClicked" />
                                                                        <MenuFlyoutItem Text="Toggle Favorite" Tag="{Binding}" Click="OnAccountFavoriteClicked" />
                                                                        <MenuFlyoutItem Text="Rename..." Tag="{Binding}" Click="OnAccountRenameClicked" />
                                                                        <MenuFlyoutSeparator />
                                                                        <MenuFlyoutItem Text="Clear Session" Tag="{Binding}" Click="OnAccountClearSessionClicked" />
                                                                        <MenuFlyoutItem Text="Open in Browser" Tag="{Binding}" Click="OnAccountOpenExternalClicked" />
                                                                        <MenuFlyoutSeparator />
                                                                        <MenuFlyoutItem Text="Delete Account" Tag="{Binding}" Click="OnAccountDeleteClicked" />
                                                                    </MenuFlyout>
                                                                </Button.ContextFlyout>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="8,6"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnAddAccountClicked"
                                                        Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11"
                                                                  Foreground="{StaticResource AppAccentBrush}" />
                                                        <TextBlock Text="Add Account"
                                                                   Foreground="{StaticResource AppAccentBrush}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel x:Name="SidebarEmptyState"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Padding="20"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8F2;"
                                      FontSize="36"
                                      Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <TextBlock Text="No AI services"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Add your first AI service to get started."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Add AI Service -->
                    <Button Grid.Row="3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10"
                            Margin="12,8,12,12"
                            Background="{ThemeResource AppSecondaryBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Click="OnAddNewServiceClicked"
                            ToolTipService.ToolTip="Add a new AI service">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12"
                                      Foreground="{StaticResource AppAccentBrush}" />
                            <TextBlock Text="Add AI Service"
                                       Foreground="{StaticResource AppAccentBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Right side -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab Bar -->
                <Border Grid.Row="0"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TabsList"
                                      ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                                      Padding="6,4,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TabItem">
                                    <Grid Height="30" MinWidth="150" MaxWidth="240">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Click="OnTabActivated"
                                                Tag="{Binding}"
                                                Padding="10,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6,6,0,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind Icon, Mode=OneWay}" FontSize="12" />
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind AccountName, Mode=OneWay}"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Click="OnTabCloseClicked"
                                                Tag="{Binding}"
                                                Width="22" Height="22"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0,0,4,0">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Toolbar -->
                <Border Grid.Row="1"
                        Background="{ThemeResource AppBackgroundBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton" Grid.Column="0" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnBackClicked" ToolTipService.ToolTip="Back">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <Button x:Name="ForwardButton" Grid.Column="1" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnForwardClicked" ToolTipService.ToolTip="Forward">
                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                        </Button>
                        <Button x:Name="ReloadButton" Grid.Column="2" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnReloadClicked" ToolTipService.ToolTip="Reload">
                            <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="14" />
                        </Button>

                        <Border Grid.Column="3"
                                Background="{ThemeResource AppSecondaryBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Height="30" Margin="4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="11"
                                          Margin="10,0,6,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBox x:Name="AddressBar" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12" Padding="0,0,10,0"
                                         KeyDown="OnAddressBarKeyDown"
                                         PlaceholderText="Search or enter URL..." />
                            </Grid>
                        </Border>

                        <Button x:Name="OpenExternalButton" Grid.Column="4" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnOpenExternalClicked" ToolTipService.ToolTip="Open in external browser">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Host + Welcome -->
                <Grid x:Name="ContentHost" Grid.Row="2" />

                <Grid x:Name="WelcomeOverlay" Grid.Row="2"
                      Background="{ThemeResource AppBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="48"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        <TextBlock Text="Welcome to DI Hub"
                                   Style="{StaticResource HeadingTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Expand a service and click an account to begin."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Overlays -->
        <controls:CommandPalette x:Name="CommandPaletteOverlay"
                                 Grid.RowSpan="2"
                                 RequestClose="OnCommandPaletteRequestClose" />

        <views:SettingsView x:Name="SettingsOverlay"
                            Grid.RowSpan="2"
                            RequestClose="OnSettingsRequestClose"
                            RequestClearAllData="OnSettingsClearAllData" />

        <views:MultiAIView x:Name="MultiAIOverlay"
                           Grid.RowSpan="2"
                           RequestClose="OnMultiAIRequestClose" />

        <controls:ToastHost x:Name="ToastOverlay" Grid.RowSpan="2" />
    </Grid>
</UserControl>