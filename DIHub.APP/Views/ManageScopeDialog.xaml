<UserControl
    x:Class="DIHub.APP.Views.ManageScopeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="500" Spacing="12">

        <!-- ══ Current state ══ -->
        <Border Background="{ThemeResource AppSecondaryBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <StackPanel Spacing="4">
                <TextBlock x:Name="ExtensionNameText"
                           Text="Extension"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                <TextBlock x:Name="CurrentStateText"
                           Text="Currently: Disabled"
                           FontSize="11"
                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ══ Scope selection ══ -->
        <TextBlock Text="Apply this extension to:"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,4,0,0"
                   Foreground="{ThemeResource AppTextPrimaryBrush}" />

        <RadioButton x:Name="RadioGlobal"
                     Content="Global — all AI accounts"
                     GroupName="ExtScope"
                     Checked="OnScopeChanged" />

        <RadioButton x:Name="RadioSpecific"
                     Content="Specific services or accounts"
                     GroupName="ExtScope"
                     Checked="OnScopeChanged" />

        <!-- ══ Targets list ══ -->
        <!-- Border has no IsEnabled in WinUI 3 — the inner ScrollViewer
             carries the disabled state. -->
        <Border Background="{ThemeResource AppSecondaryBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                MaxHeight="280"
                Margin="28,0,0,0">
            <ScrollViewer x:Name="TargetsScrollViewer"
                          IsEnabled="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- Services section -->
                    <StackPanel x:Name="ServicesSection" Spacing="4">
                        <TextBlock Text="SERVICES (applies to all their accounts)"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <StackPanel x:Name="ServiceCheckboxList" Spacing="2" />
                    </StackPanel>

                    <!-- Accounts section -->
                    <StackPanel x:Name="AccountsSection" Spacing="4">
                        <TextBlock Text="INDIVIDUAL ACCOUNTS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   Margin="0,4,0,4" />
                        <StackPanel x:Name="AccountCheckboxList" Spacing="2" />
                    </StackPanel>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyTargetsText"
                               Text="No services or accounts available."
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Enable/disable ══ -->
        <CheckBox x:Name="EnableCheck"
                  Content="Enable at the selected scope"
                  IsChecked="True"
                  Margin="0,6,0,0" />

        <!-- ══ Hint ══ -->
        <TextBlock Text="Priority: Account overrides Service, which overrides Global."
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
    </StackPanel>
</UserControl>