<UserControl
    x:Class="DIHub.APP.Views.AddEditServiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Width="420">

        <!-- Name -->
        <TextBox x:Name="NameBox"
                 Header="Name"
                 PlaceholderText="e.g. ChatGPT"
                 MaxLength="64" />

        <!-- URL -->
        <TextBox x:Name="UrlBox"
                 Header="URL"
                 PlaceholderText="https://example.com/"
                 MaxLength="512" />

        <!-- Icon picker -->
        <StackPanel Spacing="6">
            <TextBlock Text="Icon"
                       FontSize="12"
                       Foreground="{StaticResource AppTextSecondaryBrush}" />
            <StackPanel x:Name="IconPanel"
                        Orientation="Horizontal"
                        Spacing="4" />
        </StackPanel>

        <!-- Accent picker -->
        <StackPanel Spacing="6">
            <TextBlock Text="Accent Color"
                       FontSize="12"
                       Foreground="{StaticResource AppTextSecondaryBrush}" />
            <StackPanel x:Name="AccentPanel"
                        Orientation="Horizontal"
                        Spacing="8" />
        </StackPanel>

        <!-- Options -->
        <CheckBox x:Name="FavoriteCheck" Content="Mark as favorite" />
        <CheckBox x:Name="ExternalCheck" Content="Open in external browser by default" />

        <!-- Validation error -->
        <TextBlock x:Name="ErrorText"
                   Foreground="#EF4444"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>