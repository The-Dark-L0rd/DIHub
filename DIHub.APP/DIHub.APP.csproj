<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DIHub.APP</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416;CS8981;NU1506;MVVMTK0045;WMC1509</NoWarn>
    <ApplicationIcon>Assets\DIHub.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DIHub.APP</AssemblyName>
    <ApplicationTitle>DI Hub</ApplicationTitle>
    <ApplicationId>DIHub.App</ApplicationId>
    <Company>DARK L0RD</Company>
    <Product>DI Hub</Product>
    <Description>Unified AI Workspace for Windows</Description>
    <Copyright>© 2026 DARK L0RD. All rights reserved.</Copyright>
    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <AppInstallerUri>C:\Users\M.D.S\Desktop\DIHub\4.10\Publish\MSIX</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PackageCertificateThumbprint>C100D61681CBF519DFC4453081D38CA67CC206A1</PackageCertificateThumbprint>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DIHub.Core\DIHub.Core.csproj" />
    <ProjectReference Include="..\DIHub.Infrastructure\DIHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <None Remove="Controls\Extensions\ExtensionCard.xaml" />
    <None Remove="Controls\Extensions\ExtensionDiagnosticsPanel.xaml" />
    <None Remove="Controls\Extensions\ExtensionPermissionList.xaml" />
    <None Remove="Controls\Extensions\InstalledExtensionItem.xaml" />
    <None Remove="Views\ExtensionsView.xaml" />
    <None Remove="Views\ManageScopeDialog.xaml" />
    <Content Include="Assets\DIHub.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\Extensions\ExtensionDiagnosticsPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\ManageScopeDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\ExtensionsView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\Extensions\ExtensionPermissionList.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\Extensions\InstalledExtensionItem.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\Extensions\ExtensionCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>